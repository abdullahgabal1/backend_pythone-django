# ──────────────────────────────────────────────
# Daary AI Backend — Environment Variables
# Copy this file to .env and fill in the values
# ──────────────────────────────────────────────

# Django
SECRET_KEY=change-me-to-a-real-secret-key
DEBUG=True
DJANGO_ENV=dev
ALLOWED_HOSTS=localhost,127.0.0.1
LOG_LEVEL=INFO

# Database (PostgreSQL)
DATABASE_URL=postgres://daary_user:daary_pass@localhost:5432/daary_db

# JWT
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://localhost:3000

# Security (use strict values in production)
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# SMS Gateway (Twilio example — swap for CEQUENS if needed)
SMS_BACKEND=console
SMS_TWILIO_ACCOUNT_SID=
SMS_TWILIO_AUTH_TOKEN=
SMS_TWILIO_FROM_NUMBER=

# Akedly OTP Provider — from https://app.akedly.io
# Dashboard > API section for the API key, pipeline basic details for pipeline ID.
# Never commit real values.
AKEDLY_API_KEY=
AKEDLY_PIPELINE_ID=

# AI Provider
AI_PROVIDER=openai
AI_API_KEY=

# AWS S3 / DigitalOcean Spaces (for file uploads — production)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=me-south-1
AWS_S3_CUSTOM_DOMAIN=

# Redis (for Celery broker + result backend)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Optional outbound notification webhook
NOTIFICATION_WEBHOOK_URL=
