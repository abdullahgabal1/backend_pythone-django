# Akedly credentials — from https://app.akedly.io (dashboard > API section, and
# the pipeline's basic details for the pipeline ID). Never commit real values.
AKEDLY_API_KEY=
AKEDLY_PIPELINE_ID=

PORT=4000

# Comma-separated list of allowed frontend origins for CORS.
# In dev this matches the Vite app's default port.
ALLOWED_ORIGIN=http://localhost:5173
